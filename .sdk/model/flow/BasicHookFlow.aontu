# BasicHookFlow

main: kit: flow: BasicHookFlow:
{
  entity: "hook",
  kind: "basic",
  name: "BasicHookFlow",
  step: [
    {
      i: {
        ref: "hook_ref01"
      }

      m: {
        hook_id: "hook01"
      }

      o: "create"
    }

    {
      i: {
        ref: "hook_ref01",
        srcdatavar: "hook_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hook_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hook_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "hook01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicHookFlow"
}